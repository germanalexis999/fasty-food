/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://cdn.sanity.io; media-src 'self' https://cdn.sanity.io; connect-src 'self' https://*.apicdn.sanity.io https://*.api.sanity.io; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'
/config.json
  Cache-Control: no-store
/content.json
  Cache-Control: no-cache
